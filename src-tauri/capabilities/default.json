{
  "identifier": "default",
  "description": "Main window and explicitly configured HTTPS / loopback MCP connections. No filesystem or general shell plugin.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    { "identifier": "http:default", "allow": [
      { "url": "https://*" },
      { "url": "http://localhost:*" },
      { "url": "http://127.0.0.1:*" },
      { "url": "http://[::1]:*" }
    ] }
  ]
}
