{
  "name": "chista",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "tauri": "tauri",
    "test:incident-connector": "node demo/scripts/check-incident-connector.mjs",
    "test:incident-server": "node demo/scripts/access-incident-mcp.mjs",
    "video:studio": "remotion studio demo/video/index.tsx --config demo/video/remotion.config.ts",
    "video:render": "remotion render demo/video/index.tsx ChistaAccessDebugging demo/video/out/chista-access-debugging.mp4 --config demo/video/remotion.config.ts",
    "video:still": "remotion still demo/video/index.tsx ChistaAccessDebugging demo/video/out/preview.png --config demo/video/remotion.config.ts",
    "video:check": "tsc -p demo/video/tsconfig.json",
    "video:verify": "node demo/video/scripts/verify-render.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@openuidev/react-lang": "latest",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-http": "^2.8.3",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.538",
    "@remotion/cli": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/papaparse": "^5.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "remotion": "4.0.538",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "zod": "$zod"
  }
}
